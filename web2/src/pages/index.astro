---
import Layout from '../layouts/Layout.astro';
import App from '../components/App.vue';
---

<Layout>
  <main>
    <div class="container">
      <h1>MIDI Player</h1>
      <App client:load />
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .player-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  h1 {
    color: white;
    text-align: center;
    margin-bottom: 2rem;
    font-size: 2rem;
  }

  main {
    min-height: 100vh;
    background-color: #1a1a1a;
  }
</style>
