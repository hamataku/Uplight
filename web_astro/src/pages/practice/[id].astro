---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PracticeComponent from '../../components/PracticeComponent.vue';
import { videos, getVideoById } from '../../data/videos';

export const getStaticPaths = () => {
  return videos.map(video => ({
    params: { id: video.id.toString() },
  }));
};

// URLパラメータからIDを取得
const { id } = Astro.params;
console.log("Dynamic route ID:", id);
const videoData = getVideoById(id);
console.log("Video data:", videoData);

// 動画が見つからない場合はトップページにリダイレクト
if (!videoData) {
  return Astro.redirect('/Uplight/web_astro/');
}

// 動画パスを構築
const fullVideoPath = `/Uplight/web_astro${videoData.videoPath}`;
---

<Layout title={`${videoData.title} - 練習モード - Uplight`}>
  <Navbar />
  <PracticeComponent 
    videoPath={fullVideoPath}
    title={videoData.title}
    client:load 
  />
  <Footer />
</Layout>

<style>
/* Add video.js styles */
:global(.video-js) {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
}
</style>
