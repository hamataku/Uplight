---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScoringComponent from '../components/ScoringComponent.vue';
import { getVideoById } from '../data/videos';

// クエリパラメータからIDを取得
const id = Astro.url.searchParams.get('id');
const videoData = getVideoById(id);

// 動画が見つからない場合はトップページにリダイレクト
if (!videoData) {
  return Astro.redirect('/Uplight/web_astro/');
}

// ベースURLを取得して動画パスを補完
const baseUrl = Astro.url.origin;
const fullVideoPath = `${baseUrl}/Uplight${videoData.videoPath}`;
---

<Layout title={`${videoData.title} - 採点モード - Uplight`}>
  <Navbar />
  <ScoringComponent 
    videoPath={fullVideoPath}
    title={videoData.title}
    client:load 
  />
  <Footer />
</Layout>

<style>
/* Add video.js styles */
:global(.video-js) {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
}
</style>
